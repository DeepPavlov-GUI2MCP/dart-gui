[Unit]
Description=DART-GUI local desktop environment server (port 4999)
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/mnt/dart-gui/validation
Environment=DISPLAY_NUM=99
Environment=SERVER_PORT=4999
Environment=VNC_PORT=5900
Environment=NOVNC_PORT=6080
ExecStart=/usr/bin/env bash /mnt/dart-gui/validation/start_desktop.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
